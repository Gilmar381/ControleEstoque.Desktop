<Window x:Class="ControleEstoque.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="clr-namespace:ControleEstoque.Desktop.Helpers"
        Title="Controle de Estoque - Entrar"
        Width="440" Height="560"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{StaticResource Fundo}">
    <Grid VerticalAlignment="Center" Margin="36">
        <Border Style="{StaticResource Cartao}" Padding="24">
            <StackPanel>
                <TextBlock Text="📦" FontSize="42" HorizontalAlignment="Center"/>
                <TextBlock Text="Controle de Estoque" FontSize="22" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,4,0,18"/>

                <TextBlock Text="Endereço da API" Style="{StaticResource Rotulo}" Margin="0,0,0,3"/>
                <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Login" Style="{StaticResource Rotulo}"/>
                <TextBox Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Senha" Style="{StaticResource Rotulo}"/>
                <PasswordBox h:PasswordBoxHelper.Senha="{Binding Senha, UpdateSourceTrigger=PropertyChanged}"/>

                <Button Content="Entrar" IsDefault="True" Margin="0,22,0,0" Padding="14,10"
                        Command="{Binding EntrarCommand}"/>

                <ProgressBar IsIndeterminate="True" Height="3" Margin="0,12,0,0"
                             Visibility="{Binding Ocupado, Converter={StaticResource BoolVis}}"/>

                <TextBlock Text="{Binding Mensagem}" TextWrapping="Wrap" Margin="0,12,0,0"
                           Foreground="{StaticResource Erro}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
