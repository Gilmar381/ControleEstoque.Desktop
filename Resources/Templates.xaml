<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:ControleEstoque.Desktop.ViewModels"
                    xmlns:h="clr-namespace:ControleEstoque.Desktop.Helpers">

    <!-- Item de produto nos ComboBox (nome + estoque) -->
    <DataTemplate x:Key="ProdutoItem">
        <TextBlock>
            <Run Text="{Binding NomeProduto, Mode=OneWay}"/>
            <Run Text="  (estoque: " Foreground="{StaticResource TextoSuave}"/>
            <Run Text="{Binding QuantidadeEstoque, Mode=OneWay}" Foreground="{StaticResource TextoSuave}"/>
            <Run Text=")" Foreground="{StaticResource TextoSuave}"/>
        </TextBlock>
    </DataTemplate>

    <!-- Paginação reutilizável -->
    <DataTemplate DataType="{x:Type vm:Paginacao}">
        <StackPanel Orientation="Horizontal">
            <Button Content="◀  Anterior" Style="{StaticResource Secundario}"
                    Command="{Binding AnteriorCommand}" IsEnabled="{Binding PodeAnterior}"/>
            <Button Content="Próxima  ▶" Style="{StaticResource Secundario}"
                    Command="{Binding ProximaCommand}" IsEnabled="{Binding PodeProxima}"/>
            <TextBlock Text="{Binding Texto}" VerticalAlignment="Center" Margin="8,0,0,0"
                       Foreground="{StaticResource TextoSuave}"/>
        </StackPanel>
    </DataTemplate>

    <!-- ===================== PRODUTOS ===================== -->
    <DataTemplate DataType="{x:Type vm:ProdutosViewModel}">
        <Grid Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <Grid Margin="0,0,16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Produtos" Style="{StaticResource Titulo}"/>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBox Width="260" Text="{Binding Filtro, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Filtra os produtos da página exibida"/>
                    <CheckBox Content="Mostrar inativos" IsChecked="{Binding IncluirInativos}"
                              VerticalAlignment="Center" Margin="14,0,0,0"/>
                </StackPanel>

                <DataGrid Grid.Row="2" ItemsSource="{Binding Produtos}" SelectedItem="{Binding Selecionado}">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Ativo}" Value="False">
                                    <Setter Property="Foreground" Value="{StaticResource TextoSuave}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Produto" Binding="{Binding NomeProduto}" Width="*"/>
                        <DataGridTextColumn Header="Categoria" Binding="{Binding NomeCategoria}" Width="130"/>
                        <DataGridTextColumn Header="Preço" Binding="{Binding PrecoProduto, StringFormat=C}" Width="90"/>
                        <DataGridTextColumn Header="Estoque" Binding="{Binding QuantidadeEstoque}" Width="70"/>
                        <DataGridCheckBoxColumn Header="Ativo" Binding="{Binding Ativo, Mode=OneWay}" Width="55"/>
                    </DataGrid.Columns>
                </DataGrid>

                <ContentControl Grid.Row="3" Content="{Binding Pag}" Margin="0,10,0,0"/>
            </Grid>

            <Border Grid.Column="1" Style="{StaticResource Cartao}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Dados do produto" FontWeight="SemiBold" FontSize="15"/>
                        <TextBlock Text="Nome" Style="{StaticResource Rotulo}"/>
                        <TextBox Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}" MaxLength="100"/>
                        <TextBlock Text="Descrição" Style="{StaticResource Rotulo}"/>
                        <TextBox Text="{Binding Descricao, UpdateSourceTrigger=PropertyChanged}" MaxLength="200"
                                 TextWrapping="Wrap" AcceptsReturn="False" MinHeight="54"/>
                        <TextBlock Text="Preço (R$)" Style="{StaticResource Rotulo}"/>
                        <TextBox Text="{Binding Preco, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Categoria" Style="{StaticResource Rotulo}"/>
                        <ComboBox ItemsSource="{Binding Categorias}" DisplayMemberPath="NomeCategoria"
                                  SelectedItem="{Binding CategoriaSel}"/>
                        <TextBlock Text="Fornecedor" Style="{StaticResource Rotulo}"/>
                        <ComboBox ItemsSource="{Binding Fornecedores}" DisplayMemberPath="NomeFornecedor"
                                  SelectedItem="{Binding FornecedorSel}"/>
                        <CheckBox Content="Produto ativo" IsChecked="{Binding Ativo}" Margin="0,14,0,0"
                                  Visibility="{Binding Editando, Converter={StaticResource BoolVis}}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button Content="Salvar" Command="{Binding SalvarCommand}"/>
                            <Button Content="Novo" Style="{StaticResource Secundario}" Command="{Binding NovoCommand}"/>
                        </StackPanel>
                        <Button Content="Desativar produto" Style="{StaticResource Perigo}" Margin="0,10,0,0"
                                Command="{Binding DesativarCommand}" IsEnabled="{Binding Editando}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DataTemplate>

    <!-- ===================== CATEGORIAS ===================== -->
    <DataTemplate DataType="{x:Type vm:CategoriasViewModel}">
        <Grid Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <Grid Margin="0,0,16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Categorias" Style="{StaticResource Titulo}"/>
                <DataGrid Grid.Row="1" ItemsSource="{Binding Categorias}" SelectedItem="{Binding Selecionada}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Código" Binding="{Binding CategoriaId}" Width="80"/>
                        <DataGridTextColumn Header="Nome" Binding="{Binding NomeCategoria}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <Border Grid.Column="1" Style="{StaticResource Cartao}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Dados da categoria" FontWeight="SemiBold" FontSize="15"/>
                    <TextBlock Text="Nome" Style="{StaticResource Rotulo}"/>
                    <TextBox Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}" MaxLength="100"/>
                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Button Content="Salvar" Command="{Binding SalvarCommand}"/>
                        <Button Content="Novo" Style="{StaticResource Secundario}" Command="{Binding NovoCommand}"/>
                    </StackPanel>
                    <Button Content="Excluir categoria" Style="{StaticResource Perigo}" Margin="0,10,0,0"
                            Command="{Binding ExcluirCommand}" IsEnabled="{Binding Editando}"/>
                </StackPanel>
            </Border>
        </Grid>
    </DataTemplate>

    <!-- ===================== FORNECEDORES ===================== -->
    <DataTemplate DataType="{x:Type vm:FornecedoresViewModel}">
        <Grid Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <Grid Margin="0,0,16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Fornecedores" Style="{StaticResource Titulo}"/>
                <DataGrid Grid.Row="1" ItemsSource="{Binding Fornecedores}" SelectedItem="{Binding Selecionado}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nome" Binding="{Binding NomeFornecedor}" Width="*"/>
                        <DataGridTextColumn Header="CNPJ" Binding="{Binding CnpjFornecedor}" Width="150"/>
                        <DataGridTextColumn Header="Telefone" Binding="{Binding TelefoneFornecedor}" Width="120"/>
                        <DataGridTextColumn Header="E-mail" Binding="{Binding EmailFornecedor}" Width="180"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <Border Grid.Column="1" Style="{StaticResource Cartao}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Dados do fornecedor" FontWeight="SemiBold" FontSize="15"/>
                    <TextBlock Text="Nome" Style="{StaticResource Rotulo}"/>
                    <TextBox Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}" MaxLength="150"/>
                    <TextBlock Text="CNPJ" Style="{StaticResource Rotulo}"/>
                    <TextBox Text="{Binding Cnpj, UpdateSourceTrigger=PropertyChanged}" MaxLength="18"/>
                    <TextBlock Text="Telefone (com DDD)" Style="{StaticResource Rotulo}"/>
                    <TextBox Text="{Binding Telefone, UpdateSourceTrigger=PropertyChanged}" MaxLength="100"/>
                    <TextBlock Text="E-mail" Style="{StaticResource Rotulo}"/>
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" MaxLength="200"/>
                    <TextBlock Text="Endereço" Style="{StaticResource Rotulo}"/>
                    <TextBox Text="{Binding Endereco, UpdateSourceTrigger=PropertyChanged}" MaxLength="300"/>
                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Button Content="Salvar" Command="{Binding SalvarCommand}"/>
                        <Button Content="Novo" Style="{StaticResource Secundario}" Command="{Binding NovoCommand}"/>
                    </StackPanel>
                    <Button Content="Excluir fornecedor" Style="{StaticResource Perigo}" Margin="0,10,0,0"
                            Command="{Binding ExcluirCommand}" IsEnabled="{Binding Editando}"/>
                </StackPanel>
            </Border>
        </Grid>
    </DataTemplate>

    <!-- ===================== USUÁRIOS ===================== -->
    <DataTemplate DataType="{x:Type vm:UsuariosViewModel}">
        <Grid Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <Grid Margin="0,0,16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Usuários" Style="{StaticResource Titulo}"/>
                <DataGrid Grid.Row="1" ItemsSource="{Binding Usuarios}" SelectedItem="{Binding Selecionado}">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Ativo}" Value="False">
                                    <Setter Property="Foreground" Value="{StaticResource TextoSuave}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="*"/>
                        <DataGridTextColumn Header="Login" Binding="{Binding Login}" Width="110"/>
                        <DataGridTextColumn Header="Perfil" Binding="{Binding PerfilNome}" Width="100"/>
                        <DataGridTextColumn Header="Último acesso" Binding="{Binding UltimoLogin, Converter={StaticResource DataLocal}}" Width="130"/>
                        <DataGridCheckBoxColumn Header="Ativo" Binding="{Binding Ativo, Mode=OneWay}" Width="55"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <Border Grid.Column="1" Style="{StaticResource Cartao}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Dados do usuário" FontWeight="SemiBold" FontSize="15"/>
                    <TextBlock Text="Nome" Style="{StaticResource Rotulo}"/>
                    <TextBox Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}" MaxLength="100"/>
                    <TextBlock Text="E-mail" Style="{StaticResource Rotulo}"/>
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Login" Style="{StaticResource Rotulo}"/>
                    <TextBox Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" MaxLength="100"
                             IsEnabled="{Binding ModoCriacao}"/>
                    <TextBlock Text="Senha (8 a 72 caracteres)" Style="{StaticResource Rotulo}"
                               Visibility="{Binding ModoCriacao, Converter={StaticResource BoolVis}}"/>
                    <PasswordBox h:PasswordBoxHelper.Senha="{Binding Senha, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="{Binding ModoCriacao, Converter={StaticResource BoolVis}}"/>
                    <TextBlock Text="Perfil" Style="{StaticResource Rotulo}"/>
                    <ComboBox ItemsSource="{Binding Perfis}" DisplayMemberPath="Nome" SelectedItem="{Binding PerfilSel}"/>
                    <CheckBox Content="Usuário ativo" IsChecked="{Binding Ativo}" Margin="0,14,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Button Content="Salvar" Command="{Binding SalvarCommand}"/>
                        <Button Content="Novo" Style="{StaticResource Secundario}" Command="{Binding NovoCommand}"/>
                    </StackPanel>
                    <Button Content="Desativar usuário" Style="{StaticResource Perigo}" Margin="0,10,0,0"
                            Command="{Binding DesativarCommand}"
                            IsEnabled="{Binding Editando}"/>
                </StackPanel>
            </Border>
        </Grid>
    </DataTemplate>

    <!-- ===================== ESTOQUE ===================== -->
    <DataTemplate DataType="{x:Type vm:EstoqueViewModel}">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Estoque" Style="{StaticResource Titulo}"/>

            <TabControl Grid.Row="1">
                <TabItem Header="Registrar movimentação">
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MaxWidth="440"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*" MaxWidth="440"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource Cartao}" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="Entrada de estoque" FontWeight="SemiBold" FontSize="15"/>
                                <TextBlock Text="Produto" Style="{StaticResource Rotulo}"/>
                                <ComboBox ItemsSource="{Binding Produtos}" ItemTemplate="{StaticResource ProdutoItem}"
                                          SelectedItem="{Binding ProdutoEntrada}"/>
                                <TextBlock Text="Quantidade" Style="{StaticResource Rotulo}"/>
                                <TextBox Text="{Binding QuantidadeEntrada, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="Observação (nota fiscal, fornecedor...)" Style="{StaticResource Rotulo}"/>
                                <TextBox Text="{Binding ObsEntrada, UpdateSourceTrigger=PropertyChanged}" MaxLength="200"/>
                                <Button Content="Registrar entrada" Margin="0,18,0,0" HorizontalAlignment="Left"
                                        Command="{Binding RegistrarEntradaCommand}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource Cartao}" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="Saída avulsa (perda, consumo...)" FontWeight="SemiBold" FontSize="15"/>
                                <TextBlock Text="Produto" Style="{StaticResource Rotulo}"/>
                                <ComboBox ItemsSource="{Binding Produtos}" ItemTemplate="{StaticResource ProdutoItem}"
                                          SelectedItem="{Binding ProdutoSaida}"/>
                                <TextBlock Text="Quantidade" Style="{StaticResource Rotulo}"/>
                                <TextBox Text="{Binding QuantidadeSaida, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="Motivo" Style="{StaticResource Rotulo}"/>
                                <TextBox Text="{Binding ObsSaida, UpdateSourceTrigger=PropertyChanged}" MaxLength="200"/>
                                <Button Content="Registrar saída" Style="{StaticResource Perigo}" Margin="0,18,0,0"
                                        HorizontalAlignment="Left" Command="{Binding RegistrarSaidaCommand}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="Histórico">
                    <Grid Margin="0,16,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="De" Style="{StaticResource Rotulo}" Margin="0,0,0,3"/>
                                <DatePicker SelectedDate="{Binding DataInicio}" Width="130"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Até" Style="{StaticResource Rotulo}" Margin="0,0,0,3"/>
                                <DatePicker SelectedDate="{Binding DataFim}" Width="130"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Ou um produto (ignora as datas)" Style="{StaticResource Rotulo}" Margin="0,0,0,3"/>
                                <ComboBox ItemsSource="{Binding Produtos}" ItemTemplate="{StaticResource ProdutoItem}"
                                          SelectedItem="{Binding ProdutoFiltro}" Width="260"/>
                            </StackPanel>
                            <Button Content="Buscar" VerticalAlignment="Bottom" Command="{Binding BuscarCommand}"/>
                            <Button Content="Limpar" Style="{StaticResource Secundario}" VerticalAlignment="Bottom"
                                    Command="{Binding LimparFiltroCommand}"/>
                        </StackPanel>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding Historico}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Data" Binding="{Binding DataMovimentacao, Converter={StaticResource DataLocal}}" Width="130"/>
                                <DataGridTextColumn Header="Tipo" Binding="{Binding TipoMovimentacao, Converter={StaticResource TipoMov}}" Width="80"/>
                                <DataGridTextColumn Header="Produto" Binding="{Binding ProdutoNome}" Width="*"/>
                                <DataGridTextColumn Header="Qtd." Binding="{Binding Quantidade}" Width="60"/>
                                <DataGridTextColumn Header="Usuário" Binding="{Binding UsuarioNome}" Width="140"/>
                                <DataGridTextColumn Header="Observação" Binding="{Binding Observacao}" Width="220"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <ContentControl Grid.Row="2" Content="{Binding Pag}" Margin="0,10,0,0"/>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </DataTemplate>

    <!-- ===================== VENDA (PDV) ===================== -->
    <DataTemplate DataType="{x:Type vm:VendaViewModel}">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Nova venda" Style="{StaticResource Titulo}"/>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Produtos disponíveis -->
                <Border Style="{StaticResource Cartao}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBox Text="{Binding Filtro, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Buscar produto pelo nome" Margin="0,0,0,10"/>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding CatalogoView}" SelectedItem="{Binding ProdutoSel}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Produto" Binding="{Binding NomeProduto}" Width="*"/>
                                <DataGridTextColumn Header="Preço" Binding="{Binding PrecoProduto, StringFormat=C}" Width="90"/>
                                <DataGridTextColumn Header="Estoque" Binding="{Binding QuantidadeEstoque}" Width="70"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="Qtd." VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Width="70" Text="{Binding QuantidadeAdicionar, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,10,0">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding AdicionarCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                            <Button Content="Adicionar ao carrinho" Command="{Binding AdicionarCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Carrinho -->
                <Border Grid.Column="2" Style="{StaticResource Cartao}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DataGrid ItemsSource="{Binding Carrinho}" IsReadOnly="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Produto" Binding="{Binding Nome}" Width="*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Qtd." Binding="{Binding Quantidade, UpdateSourceTrigger=LostFocus}" Width="60"/>
                                <DataGridTextColumn Header="Preço" Binding="{Binding PrecoUnitario, StringFormat=C}" Width="85" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, StringFormat=C}" Width="95" IsReadOnly="True"/>
                                <DataGridTemplateColumn Width="44">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="✕" Style="{StaticResource Perigo}" Padding="8,2" Margin="0"
                                                    Command="{Binding DataContext.RemoverCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Row="1" Margin="0,12,0,0">
                            <TextBlock Text="Forma de pagamento" Style="{StaticResource Rotulo}" Margin="0,0,0,3"/>
                            <ComboBox ItemsSource="{Binding FormasPagamento}" DisplayMemberPath="Nome"
                                      SelectedItem="{Binding PagamentoSel}"/>
                            <TextBlock Text="{Binding Total, StringFormat='Total: {0:C}'}" FontSize="26"
                                       FontWeight="Bold" HorizontalAlignment="Right" Margin="0,14,0,10"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Cancelar" Style="{StaticResource Secundario}"
                                        Command="{Binding CancelarCommand}"/>
                                <Button Content="Finalizar venda" Margin="0" Padding="22,10"
                                        Command="{Binding FinalizarCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </DataTemplate>

    <!-- ===================== HISTÓRICO DE VENDAS ===================== -->
    <DataTemplate DataType="{x:Type vm:VendasViewModel}">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="180"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Vendas" Style="{StaticResource Titulo}"/>

            <DataGrid Grid.Row="1" ItemsSource="{Binding Vendas}" SelectedItem="{Binding Selecionada}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nº" Binding="{Binding Id}" Width="70"/>
                    <DataGridTextColumn Header="Data" Binding="{Binding Data, Converter={StaticResource DataLocal}}" Width="140"/>
                    <DataGridTextColumn Header="Vendedor" Binding="{Binding Usuario}" Width="*"/>
                    <DataGridTextColumn Header="Pagamento" Binding="{Binding Pagamento}" Width="150"/>
                    <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=C}" Width="110"/>
                </DataGrid.Columns>
            </DataGrid>

            <ContentControl Grid.Row="2" Content="{Binding Pag}" Margin="0,10,0,10"/>

            <DataGrid Grid.Row="3" ItemsSource="{Binding Itens}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Itens da venda selecionada" Binding="{Binding ProdutoNome}" Width="*"/>
                    <DataGridTextColumn Header="Qtd." Binding="{Binding Quantidade}" Width="70"/>
                    <DataGridTextColumn Header="Preço" Binding="{Binding PrecoUnitario, StringFormat=C}" Width="110"/>
                    <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, StringFormat=C}" Width="110"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DataTemplate>

    <!-- ===================== MINHA CONTA ===================== -->
    <DataTemplate DataType="{x:Type vm:ContaViewModel}">
        <Grid Margin="24">
            <StackPanel>
                <TextBlock Text="Minha conta" Style="{StaticResource Titulo}"/>
                <Border Style="{StaticResource Cartao}" Width="420" HorizontalAlignment="Left">
                    <StackPanel>
                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding Nome}"/>
                        <TextBlock Foreground="{StaticResource TextoSuave}" Text="{Binding Perfil}"/>

                        <TextBlock Text="Senha atual" Style="{StaticResource Rotulo}" Margin="0,18,0,3"/>
                        <PasswordBox h:PasswordBoxHelper.Senha="{Binding SenhaAtual, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Nova senha (8 a 72 caracteres)" Style="{StaticResource Rotulo}"/>
                        <PasswordBox h:PasswordBoxHelper.Senha="{Binding NovaSenha, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Confirmar nova senha" Style="{StaticResource Rotulo}"/>
                        <PasswordBox h:PasswordBoxHelper.Senha="{Binding Confirmar, UpdateSourceTrigger=PropertyChanged}"/>

                        <Button Content="Alterar senha" Margin="0,18,0,0" HorizontalAlignment="Left"
                                Command="{Binding AlterarCommand}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
